{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Desktop Debug",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "build"
            ],
            "options": {
                "cwd": "${workspaceFolder}/WebGL2"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Build Desktop Release",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "build",
                "--config",
                "Release"
            ],
            "options": {
                "cwd": "${workspaceFolder}/WebGL2"
            },
            "group": "build",
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Build WebGL",
            "type": "shell",
            "command": "emmake",
            "args": [
                "cmake",
                "--build",
                "."
            ],
            "options": {
                "cwd": "${workspaceFolder}/WebGL2/build_web"
            },
            "group": "build",
            "problemMatcher": "$gcc"
        },
        {
            "label": "Configure Desktop",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-B",
                "build",
                "-S",
                "."
            ],
            "options": {
                "cwd": "${workspaceFolder}/WebGL2"
            },
            "problemMatcher": []
        },
        {
            "label": "Configure WebGL",
            "type": "shell",
            "command": "emcmake",
            "args": [
                "cmake",
                ".."
            ],
            "options": {
                "cwd": "${workspaceFolder}/WebGL2/build_web"
            },
            "problemMatcher": []
        },
        {
            "label": "Build and Run WebGL",
            "dependsOn": ["Build WebGL", "Run WebGL (emrun)"],
            "dependsOrder": "sequence",
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Run WebGL (emrun)",
            "type": "shell",
            "command": "emrun",
            "args": [
                "--port",
                "8080",
                "--no_emrun_detect",
                "MeshMakerWebGL2.html"
            ],
            "options": {
                "cwd": "${workspaceFolder}/WebGL2/build_web"
            },
            "problemMatcher": []
        },
        {
            "label": "Start WebGL Server",
            "type": "shell",
            "command": "emrun",
            "args": [
                "--port",
                "8080",
                "--no_browser",
                "MeshMakerWebGL2.html"
            ],
            "options": {
                "cwd": "${workspaceFolder}/WebGL2/build_web"
            },
            "isBackground": true,
            "problemMatcher": {
                "owner": "emrun",
                "pattern": {
                    "regexp": "^$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".*",
                    "endsPattern": "^Web server"
                }
            }
        },
        {
            "label": "Build and Start WebGL Server",
            "dependsOn": ["Build WebGL", "Start WebGL Server"],
            "dependsOrder": "sequence",
            "problemMatcher": []
        },
        {
            "label": "Clean Desktop",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "build",
                "--target",
                "clean"
            ],
            "options": {
                "cwd": "${workspaceFolder}/WebGL2"
            },
            "problemMatcher": []
        }
    ]
}
