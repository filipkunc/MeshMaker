{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Configure Desktop Debug",
            "type": "shell",
            "command": "cmake",
            "args": ["--preset", "desktop-debug", "--fresh"],
            "options": {
                "cwd": "${workspaceFolder}/WebGL2"
            },
            "problemMatcher": []
        },
        {
            "label": "Configure Desktop Release",
            "type": "shell",
            "command": "cmake",
            "args": ["--preset", "desktop-release", "--fresh"],
            "options": {
                "cwd": "${workspaceFolder}/WebGL2"
            },
            "problemMatcher": []
        },
        {
            "label": "Build Desktop Debug",
            "type": "shell",
            "command": "bash",
            "args": ["-c", "cmake --preset desktop-debug --fresh && ninja -C build"],
            "options": {
                "cwd": "${workspaceFolder}/WebGL2"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Build Desktop Release",
            "type": "shell",
            "command": "bash",
            "args": ["-c", "cmake --preset desktop-release --fresh && ninja -C build"],
            "options": {
                "cwd": "${workspaceFolder}/WebGL2"
            },
            "group": "build",
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Clean Desktop",
            "type": "shell",
            "command": "ninja",
            "args": ["-C", "build", "clean"],
            "options": {
                "cwd": "${workspaceFolder}/WebGL2"
            },
            "problemMatcher": []
        },
        {
            "label": "Build WASM",
            "type": "shell",
            "command": "bash",
            "args": ["-c", "source $HOME/emsdk/emsdk_env.sh && cmake --preset webgl && ninja -C build-wasm"],
            "windows": {
                "command": "C:\\emsdk\\emsdk_env.ps1; cmake --preset webgl; ninja -C build-wasm",
                "args": []
            },
            "options": {
                "cwd": "${workspaceFolder}/WebGL2"
            },
            "group": "build",
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Configure WASM Debug",
            "type": "shell",
            "command": "bash",
            "args": ["-c", "source $HOME/emsdk/emsdk_env.sh && cmake --preset webgl-debug"],
            "windows": {
                "command": "C:\\emsdk\\emsdk_env.ps1; cmake --preset webgl-debug",
                "args": []
            },
            "options": {
                "cwd": "${workspaceFolder}/WebGL2"
            },
            "problemMatcher": []
        },
        {
            "label": "Build WASM Debug",
            "type": "shell",
            "command": "bash",
            "args": ["-c", "source $HOME/emsdk/emsdk_env.sh && cmake --preset webgl-debug && ninja -C build-wasm-debug"],
            "windows": {
                "command": "C:\\emsdk\\emsdk_env.ps1; cmake --preset webgl-debug; ninja -C build-wasm-debug",
                "args": []
            },
            "options": {
                "cwd": "${workspaceFolder}/WebGL2"
            },
            "group": "build",
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Copy WASM Debug to React",
            "type": "shell",
            "command": "npm",
            "args": ["run", "copy-wasm-debug"],
            "options": {
                "cwd": "${workspaceFolder}/MeshMakerWeb"
            },
            "problemMatcher": []
        },
        {
            "label": "Build WASM Debug and Copy",
            "dependsOn": ["Build WASM Debug", "Copy WASM Debug to React"],
            "dependsOrder": "sequence",
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Build and Start React (Debug WASM)",
            "dependsOn": ["Build WASM Debug and Copy", "Start React Dev Server"],
            "dependsOrder": "sequence",
            "problemMatcher": []
        },
        {
            "label": "Copy WASM to React",
            "type": "shell",
            "command": "npm",
            "args": ["run", "copy-wasm"],
            "options": {
                "cwd": "${workspaceFolder}/MeshMakerWeb"
            },
            "problemMatcher": []
        },
        {
            "label": "Build WASM and Copy",
            "dependsOn": ["Build WASM", "Copy WASM to React"],
            "dependsOrder": "sequence",
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Start React Dev Server",
            "type": "shell",
            "command": "npm",
            "args": ["run", "dev"],
            "options": {
                "cwd": "${workspaceFolder}/MeshMakerWeb"
            },
            "isBackground": true,
            "problemMatcher": {
                "owner": "vite",
                "pattern": {
                    "regexp": "^NEVER_MATCH_ANYTHING$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^>.*dev$",
                    "endsPattern": "ready in"
                }
            }
        },
        {
            "label": "Build and Start React",
            "dependsOn": ["Build WASM and Copy", "Start React Dev Server"],
            "dependsOrder": "sequence",
            "problemMatcher": []
        },
        {
            "label": "Build React Production",
            "type": "shell",
            "command": "npm",
            "args": ["run", "build"],
            "options": {
                "cwd": "${workspaceFolder}/MeshMakerWeb"
            },
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Deploy to Cloudflare Pages",
            "type": "shell",
            "command": "npx",
            "args": [
                "wrangler",
                "pages",
                "deploy",
                "dist",
                "--project-name=meshmaker",
                "--branch=main"
            ],
            "options": {
                "cwd": "${workspaceFolder}/MeshMakerWeb"
            },
            "problemMatcher": []
        },
        {
            "label": "Build and Deploy to Cloudflare",
            "dependsOn": ["Build WASM and Copy", "Build React Production", "Deploy to Cloudflare Pages"],
            "dependsOrder": "sequence",
            "problemMatcher": []
        },
        {
            "label": "Start Hunyuan3D-2 Server",
            "type": "shell",
            "command": "bash",
            "args": ["-c", "export PATH=$HOME/.local/bin:$PATH && uv run python gradio_app.py --model_path tencent/Hunyuan3D-2mini --subfolder hunyuan3d-dit-v2-mini --texgen_model_path tencent/Hunyuan3D-2 --low_vram_mode"],
            "options": {
                "cwd": "${workspaceFolder}/Hunyuan3D-2"
            },
            "isBackground": true,
            "problemMatcher": {
                "owner": "hunyuan",
                "pattern": {
                    "regexp": "^$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".*",
                    "endsPattern": "Uvicorn running"
                }
            }
        },
        {
            "label": "Start Hunyuan3D-2 Server (Full)",
            "type": "shell",
            "command": "bash",
            "args": ["-c", "export PATH=$HOME/.local/bin:$PATH && uv run python gradio_app.py --model_path tencent/Hunyuan3D-2mini --subfolder hunyuan3d-dit-v2-mini --texgen_model_path tencent/Hunyuan3D-2 --low_vram_mode --enable_t23d"],
            "options": {
                "cwd": "${workspaceFolder}/Hunyuan3D-2"
            },
            "isBackground": true,
            "problemMatcher": {
                "owner": "hunyuan",
                "pattern": {
                    "regexp": "^$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".*",
                    "endsPattern": "Uvicorn running"
                }
            }
        },
        {
            "label": "Start React + Hunyuan3D-2 Servers",
            "dependsOn": ["Start Hunyuan3D-2 Server", "Start React Dev Server"],
            "dependsOrder": "parallel",
            "problemMatcher": []
        },
        {
            "label": "Start React + Hunyuan3D-2 Servers (Full)",
            "dependsOn": ["Start Hunyuan3D-2 Server (Full)", "Start React Dev Server"],
            "dependsOrder": "parallel",
            "problemMatcher": []
        },
        {
            "label": "Build and Start React + Hunyuan3D-2",
            "dependsOn": ["Build WASM and Copy", "Start React + Hunyuan3D-2 Servers"],
            "dependsOrder": "sequence",
            "problemMatcher": []
        },
        {
            "label": "Build and Start React + Hunyuan3D-2 (Full)",
            "dependsOn": ["Build WASM and Copy", "Start React + Hunyuan3D-2 Servers (Full)"],
            "dependsOrder": "sequence",
            "problemMatcher": []
        }
    ]
}
