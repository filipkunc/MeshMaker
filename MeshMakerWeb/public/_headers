/*
  Access-Control-Allow-Origin: *
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: credentialless

/assets/*.js
  Content-Type: application/javascript

/assets/*.css
  Content-Type: text/css

/wasm/*.wasm
  Content-Type: application/wasm

/wasm/*.js
  Content-Type: application/javascript
